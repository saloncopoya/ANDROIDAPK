<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🚀 Laboratorio Pro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ventana flotante interactiva + notificaciones + widgets"
            android:textSize="13sp"
            android:textColor="#666666" />

        <!-- ========== SECCIÓN VENTANA FLOTANTE (PRINCIPAL) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🪟 Ventana Flotante Interactiva"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6200EE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_floating_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingStop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_floating_stop" />

        <!-- ========== SECCIÓN NOTIFICACIONES ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🔔 Notificaciones"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6200EE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifSimple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_notif_simple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_notif_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_notif_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_notif_vibrate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearNotifs"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_clear_notifs" />

        <!-- ========== SECCIÓN SISTEMA / SERVICIOS ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="⚙️ Sistema"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6200EE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_start_service" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_pip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWorkManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_work_manager" />

        <!-- ========== SECCIÓN HERRAMIENTAS ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🛠️ Herramientas"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6200EE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_share_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_share_image" />

        <!-- ========== CONFIGURACIÓN ========== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestAll"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/btn_test_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/btn_deep_link_info"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>
</ScrollView>
